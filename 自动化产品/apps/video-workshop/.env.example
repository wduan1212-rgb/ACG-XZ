# 默认会自动读取主产品 ../../.env.local；也可以显式指定另一份服务器环境文件。
FALLBACK_ENV=../../.env.local

LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com
LLM_ENDPOINT=https://api.minimaxi.com/v1/chat/completions
LLM_MAX_COMPLETION_TOKENS=16000

SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_RESOLUTION=720p

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
# 主平台音色设计使用 GroupId 时，sidecar 必须沿用同一值才能调用该音色 ID。
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_VOICE_ID=moss_audio_ce44fc67-7ce3-11f0-8de5-96e35d26fb85

# small 会在首次使用时下载；无外网部署可改成本地 CTranslate2 模型绝对路径。
ASR_MODEL=small
ASR_LANGUAGE=zh
HF_HOME=../../runtime/model-cache
# 默认只读主平台共享 BGM 资产；DATA_DB / UPLOAD_DIR 必须与主服务一致。
BGM_SOURCE=platform
DATA_DB=../../server/data.sqlite
UPLOAD_DIR=../../server/uploads
# 仅在显式改为 BGM_SOURCE=local 时使用。
BGM_LIBRARY_DIR=../../runtime/bgm-library

# 本机可填写 http://127.0.0.1:7897；服务器通常留空或换成服务器自己的出口代理。
OUTBOUND_PROXY=

# Sidecar 必须只监听回环地址；不要复用主服务的 HOST/PORT。
VIDEO_WORKSHOP_HOST=127.0.0.1
VIDEO_WORKSHOP_PORT=8765
VIDEO_WORKSHOP_LIVE=true

# 可选：生产环境把运行数据放入持久卷。主服务使用相同变量读取成片和附件。
# 生产部署使用代码目录之外的持久路径；直接本地运行也可改回 ./data、./outputs、./uploads。
VIDEO_WORKSHOP_PROJECTS_DIR=../../runtime/video-workshop/projects
VIDEO_WORKSHOP_OUTPUT_DIR=../../runtime/video-workshop/outputs
VIDEO_WORKSHOP_UPLOAD_DIR=../../runtime/video-workshop/uploads
VIDEO_WORKSHOP_WEB_DIR=./web
VIDEO_WORKSHOP_SKILLS_DIR=./skills
VIDEO_WORKSHOP_OPENMONTAGE_ROOT=./vendor/OpenMontage
