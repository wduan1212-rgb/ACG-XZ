# 主平台嵌入构建不需要在子应用中配置模型密钥。
# 客户端直连默认关闭；只有独立 Pages 构建才可显式设为 1。
NEXT_PUBLIC_CLIENT_PROVIDER=0
# 独立 Next.js 服务模式如需调试，可在本机 .env.local 中填写以下服务端变量；
# .env.local 已被 .gitignore 排除，任何真实值都不得提交或复制到 vendor 目录。
MAAS_API_KEY=
MAAS_BASE_URL=
MAAS_CHAT_API_KEY=
MAAS_CHAT_BASE_URL=
MAAS_IMAGE_MODEL=
MAAS_TEXT_MODEL=
MAAS_VISION_MODEL=
MAAS_IMAGE_LOGO_ADD=0
